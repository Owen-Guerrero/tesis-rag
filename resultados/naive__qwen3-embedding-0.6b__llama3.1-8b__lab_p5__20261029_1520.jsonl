, "t_embedding_consulta_s": 1.8931, "t_busqueda_s": 0.0178, "respuesta": "Según el NIST SP 800-53, para gestionar el ciclo de vida de las cuentas del sistema, es decir, su creación, habilitación, modificación, deshabilitación y eliminación, se exige lo siguiente:\n\n* Crear, habilitar, gestionar y deshabilitar cuentas del sistema de manera dinámica (Fragmento 3).\n* Establecer y implementar un proceso para cambiar los autenticadores de cuentas compartidas o de grupo cuando los individuos son removidos del grupo (Fragmento 15).\n* Automatizar la creación, habilitación, modificación, deshabilitación y eliminación de cuentas del sistema (Fragmento 11).\n* Establecer y documentar los tipos de cuentas permitidas y específicamente prohibidas para su uso dentro del sistema (Fragmento 7).\n* Crear, habilitar, modificar, deshabilitar y eliminar cuentas del sistema en accordance con las políticas y procedimientos organizacionales (Fragmento 9).\n\nCita: [NIST AC-2(3)]", "tokens_entrada": 2751, "tokens_salida": 236, "t_primer_token_aprox_s": 0.289, "t_generacion_s": 2.025, "tokens_por_s": 137.2, "fin": "stop", "vram_gpu_mb": 12679, "t_total_s": 4.038, "recall@5": 1.0, "recall@10": 1.0, "mrr": 1.0, "citas": ["NIST-AC-2"], "citas_en_contexto": 1.0, "citas_esperadas": 1.0, "sin_evidencia": false}
